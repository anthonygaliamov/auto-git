{
  "name": "auto-sync",
  "displayName": "Auto Sync",
  "description": "Periodically fetches, pulls and pushes your git repos.",
  "version": "0.2.0",
  "publisher": "anthonygaliamov",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonygaliamov/auto-sync.git"
  },
  "bugs": {
    "url": "https://github.com/anthonygaliamov/auto-sync/issues"
  },
  "homepage": "https://github.com/anthonygaliamov/auto-sync#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "sync",
    "auto fetch",
    "auto pull",
    "auto push",
    "fast-forward",
    "repositories"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Auto Sync runs git fetch, pull and push, which can execute programs configured by the repository."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Auto Sync needs repositories on a local file system."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "autoSync.syncAll",
        "title": "Sync All Repositories Now",
        "category": "Auto Sync"
      },
      {
        "command": "autoSync.syncRepository",
        "title": "Sync This Repository",
        "category": "Auto Sync"
      },
      {
        "command": "autoSync.pause",
        "title": "Pause",
        "category": "Auto Sync",
        "enablement": "!autoSync.paused"
      },
      {
        "command": "autoSync.resume",
        "title": "Resume",
        "category": "Auto Sync",
        "enablement": "autoSync.paused"
      },
      {
        "command": "autoSync.showLog",
        "title": "Show Log",
        "category": "Auto Sync"
      },
      {
        "command": "autoSync.showIssues",
        "title": "Show Issues",
        "category": "Auto Sync"
      }
    ],
    "configuration": {
      "title": "Auto Sync",
      "properties": {
        "autoSync.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Sync repositories automatically. Set it to false in a repo folder's settings to opt that repo out."
        },
        "autoSync.intervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Minutes between syncs."
        },
        "autoSync.scanDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "How many folder levels to search inside each workspace folder for nested repositories."
        },
        "autoSync.includeRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute repository paths. If not empty, only these repositories are synced."
        },
        "autoSync.excludeRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute repository paths that are never synced. Takes priority over includeRepos."
        },
        "autoSync.syncOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Sync shortly after VS Code starts."
        },
        "autoSync.syncOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "Sync when the window regains focus and the last sync is older than the interval."
        },
        "autoSync.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications for problems that need attention."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run typecheck && node esbuild.js",
    "package": "npm run typecheck && node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "build:tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run build:tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && npm run build:tests && node out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "mocha": "^12.0.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
